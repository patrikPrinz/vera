{
  "compilerOptions": {
    "esModuleInterop": true,
    "skipLibCheck": true,
    "allowJs": true,
    "resolveJsonModule": true,
    "target": "es2022",
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "isolatedModules": true,

    "baseUrl": ".",
    "sourceMap": true,
    "composite": true,
    "paths": {
      "@vera/shared": ["packages/shared/index.ts"],
      "@vera/shared/*": ["packages/shared/*"],
    },
  },
}
