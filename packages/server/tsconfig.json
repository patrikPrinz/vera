{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",

    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "verbatimModuleSyntax": false,
    "esModuleInterop": true,

    "module": "ESNext",
    "moduleResolution": "node",

    "types": ["jest", "node"],
    "lib": ["es2022"],
  },
  "include": ["./src"],
  "exclude": ["./node_modules", "./dist", "./tests"],
  "references": [{ "path": "../shared" }],
}
